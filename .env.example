# Sorta environment. `npm run setup` copies this to .env.local, generates SIFT_SECRET and checks the rest.
# Never commit .env.local.

# ── Supabase (required) ──────────────────────────────────────────────────
# Project Settings → API keys.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only: live new mail, the Jev quota and the logo cache run without a signed-in user.
# Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...

# Only for `npm run db:migrate` (not needed at runtime, not uploaded to Vercel).
# Dashboard → Connect → Session pooler, with your database password filled in.
SUPABASE_DB_URL=

# ── Secrets (required) ───────────────────────────────────────────────────
# Seals each user's Composio API key (AES-256-GCM). At least 32 characters; `npm run setup` generates one.
# Keep it stable: changing it means every user has to paste their Composio key again.
SIFT_SECRET=

# ── Jev (required) ───────────────────────────────────────────────────────
# Any provider serving Jev over TypeSafe's /v1/systemone API. JEV_BASE_URL is the API root
# (the app adds /v1/systemone; a pasted .../v1 or .../v1/systemone works too).
#
#   Command Code   JEV_BASE_URL=https://api.commandcode.ai/provider   JEV_MODEL=typesafe/jev
#   TypeSafe       JEV_BASE_URL=https://api.typesafe.ai               JEV_MODEL=jev-latest
#
# `npm run check:jev` makes one test call with these.
JEV_API_KEY=
JEV_BASE_URL=https://api.commandcode.ai/provider
JEV_MODEL=typesafe/jev

# Per-user daily cap on emails Jev reads. Set it on any public deploy: it's your key paying.
JEV_DAILY_LIMIT=1500

# ── Deploy (optional) ────────────────────────────────────────────────────
# The public URL, e.g. https://sorta.vercel.app. Pins Composio's OAuth callback; defaults to the request's origin.
APP_URL=

# ── Composio (optional) ──────────────────────────────────────────────────
# Each user pastes their own Composio API key in the app, so nothing is required here.
# COMPOSIO_USER_ID=sift-default          Composio user that new Gmail connections are made under
# COMPOSIO_GMAIL_AUTH_CONFIG_ID=ac_...   otherwise found or created automatically
